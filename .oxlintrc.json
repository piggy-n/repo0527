{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "vue", "promise", "vitest"],
  "jsPlugins": ["eslint-plugin-boundaries"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "settings": {
    "import/resolver": {
      "typescript": {
        "project": ["apps/yzt/tsconfig.app.json", "packages/*/tsconfig.lib.json"],
        "noWarnOnMultipleProjects": true
      }
    },
    "boundaries/elements": [
      { "type": "app", "pattern": "apps/yzt/src/app" },
      { "type": "pages", "pattern": "apps/yzt/src/pages" },
      { "type": "feature", "pattern": "apps/yzt/src/features/*", "capture": ["name"] },
      { "type": "shared", "pattern": "apps/yzt/src/shared" },
      { "type": "package", "pattern": "packages/*", "capture": ["name"] }
    ]
  },
  "rules": {
    "typescript/no-unsafe-type-assertion": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss", "core-js/**"] }],

    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "lodash-es", "importNames": ["default"], "message": "lodash-es 按需具名导入" },
          { "name": "maplibre-gl", "message": "maplibre-gl 只能在 packages/map-core/src/maplibre 和 app 中导入（ADR 0024）" },
          { "name": "cesium", "message": "cesium 只能在 packages/map-cesium 和 app 中导入（ADR 0079）" },
          { "name": "three", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" },
          { "name": "3d-tiles-renderer", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" },
          { "name": "gaussian-splat-lite", "message": "gaussian-splat-lite 只能在 packages/map-three 中导入（ADR 0149）" }
        ],
        "patterns": [
          { "regex": "^lodash(/|$)", "message": "使用 lodash-es 并按需具名导入" },
          { "regex": "^maplibre-gl/", "message": "maplibre-gl 只能在 packages/map-core/src/maplibre 和 app 中导入（ADR 0024）" },
          { "regex": "^(cesium/|@cesium/)", "message": "cesium 只能在 packages/map-cesium 和 app 中导入（ADR 0079）" },
          { "regex": "^(three|3d-tiles-renderer)/", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" }
        ]
      }
    ],

    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-deprecated": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{js,mjs,cjs}"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["scripts/**", "apps/yzt/tools/**", "packages/*/tools/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/map-three/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "lodash-es", "importNames": ["default"], "message": "lodash-es 按需具名导入" },
              { "name": "maplibre-gl", "message": "maplibre-gl 只能在 packages/map-core/src/maplibre 和 app 中导入（ADR 0024）" },
              { "name": "cesium", "message": "cesium 只能在 packages/map-cesium 和 app 中导入（ADR 0079）" }
            ],
            "patterns": [
              { "regex": "^lodash(/|$)", "message": "使用 lodash-es 并按需具名导入" },
              { "regex": "^maplibre-gl/", "message": "maplibre-gl 只能在 packages/map-core/src/maplibre 和 app 中导入（ADR 0024）" },
              { "regex": "^(cesium/|@cesium/)", "message": "cesium 只能在 packages/map-cesium 和 app 中导入（ADR 0079）" }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/yzt/src/features/city-dashboard/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "lodash-es", "importNames": ["default"], "message": "lodash-es 按需具名导入" },
              { "name": "maplibre-gl", "message": "maplibre-gl 只能在 packages/map-core/src/maplibre 和 app 中导入（ADR 0024）" },
              { "name": "cesium", "message": "cesium 只能在 packages/map-cesium 和 app 中导入（ADR 0079）" },
              { "name": "gaussian-splat-lite", "message": "gaussian-splat-lite 只能在 packages/map-three 中导入（ADR 0149）" }
            ],
            "patterns": [
              { "regex": "^lodash(/|$)", "message": "使用 lodash-es 并按需具名导入" },
              { "regex": "^maplibre-gl/", "message": "maplibre-gl 只能在 packages/map-core/src/maplibre 和 app 中导入（ADR 0024）" },
              { "regex": "^(cesium/|@cesium/)", "message": "cesium 只能在 packages/map-cesium 和 app 中导入（ADR 0079）" }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/map-core/src/maplibre/**", "packages/*/src/test-setup.browser.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "lodash-es", "importNames": ["default"], "message": "lodash-es 按需具名导入" },
              { "name": "cesium", "message": "cesium 只能在 packages/map-cesium 和 app 中导入（ADR 0079）" },
              { "name": "three", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" },
              { "name": "3d-tiles-renderer", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" },
              { "name": "gaussian-splat-lite", "message": "gaussian-splat-lite 只能在 packages/map-three 中导入（ADR 0149）" }
            ],
            "patterns": [
              { "regex": "^lodash(/|$)", "message": "使用 lodash-es 并按需具名导入" },
              { "regex": "^(cesium/|@cesium/)", "message": "cesium 只能在 packages/map-cesium 和 app 中导入（ADR 0079）" },
              { "regex": "^(three|3d-tiles-renderer)/", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/map-cesium/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "lodash-es", "importNames": ["default"], "message": "lodash-es 按需具名导入" },
              { "name": "maplibre-gl", "message": "maplibre-gl 只能在 packages/map-core/src/maplibre 和 app 中导入（ADR 0024）" },
              { "name": "three", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" },
              { "name": "3d-tiles-renderer", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" },
              { "name": "gaussian-splat-lite", "message": "gaussian-splat-lite 只能在 packages/map-three 中导入（ADR 0149）" }
            ],
            "patterns": [
              { "regex": "^lodash(/|$)", "message": "使用 lodash-es 并按需具名导入" },
              { "regex": "^maplibre-gl/", "message": "maplibre-gl 只能在 packages/map-core/src/maplibre 和 app 中导入（ADR 0024）" },
              { "regex": "^(three|3d-tiles-renderer)/", "message": "three、3d-tiles-renderer 只能在 packages/map-three 和驾驶舱中导入（ADR 0147）" }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/yzt/src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "lodash-es", "importNames": ["default"], "message": "lodash-es 按需具名导入" },
              { "name": "gaussian-splat-lite", "message": "gaussian-splat-lite 只能在 packages/map-three 中导入（ADR 0149）" }
            ],
            "patterns": [
              { "regex": "^lodash(/|$)", "message": "使用 lodash-es 并按需具名导入" }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/**", "packages/*/tools/**"],
      "rules": {
        "boundaries/dependencies": [
          "error",
          {
            "default": "disallow",
            "checkAllOrigins": true,
            "checkInternals": true,
            "policies": [
              { "allow": { "to": { "module": { "origin": "external" } } } },
              { "allow": { "to": { "module": { "origin": "core" } } } },
              { "allow": { "dependency": { "relationship": { "to": "internal" }, "source": "@(./|+(../))**" } } },
              {
                "from": { "element": { "type": "package", "captured": { "name": "{ui,map-core,map-cesium,map-three,map-vue}" } } },
                "allow": {
                  "to": { "element": { "type": "package", "captured": { "name": "utils" } } },
                  "dependency": { "source": "@mx/*" }
                }
              },
              {
                "from": { "element": { "type": "package", "captured": { "name": "{map-cesium,map-three,map-vue}" } } },
                "allow": {
                  "to": { "element": { "type": "package", "captured": { "name": "map-core" } } },
                  "dependency": { "source": "@mx/*" }
                }
              },
              {
                "from": { "element": { "type": "package", "captured": { "name": "map-vue" } } },
                "allow": {
                  "to": { "element": { "type": "package", "captured": { "name": "{map-cesium,map-three}" } } },
                  "dependency": { "source": "@mx/*", "nodeKind": "dynamic-import" }
                }
              },
              {
                "from": { "element": { "type": "package", "captured": { "name": "map-tools" } } },
                "allow": {
                  "to": { "element": { "type": "package", "captured": { "name": "{map-core,map-vue}" } } },
                  "dependency": { "source": "@mx/*" }
                }
              },
              {
                "from": { "element": { "type": "package", "captured": { "name": "{utils,map-core,map-cesium,map-three}" } } },
                "disallow": {
                  "to": {
                    "module": {
                      "source": ["vue", "vue-router", "pinia", "element-plus", "@vue/**", "@element-plus/**"]
                    }
                  }
                }
              },
              {
                "from": { "element": { "type": "package", "captured": { "name": "{map-vue,map-tools}" } } },
                "disallow": {
                  "to": { "module": { "source": ["vue-router", "pinia", "element-plus", "@element-plus/**"] } }
                }
              },
              { "disallow": { "to": { "module": { "source": "mapbox-gl" } } } }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/yzt/src/**"],
      "rules": {
        "boundaries/dependencies": [
          "error",
          {
            "default": "disallow",
            "checkAllOrigins": true,
            "checkInternals": true,
            "policies": [
              { "allow": { "to": { "module": { "origin": "external" } } } },
              { "allow": { "dependency": { "relationship": { "to": "internal" }, "source": "@(./|+(../))**" } } },
              {
                "from": { "element": { "type": "app" } },
                "allow": { "to": { "element": { "types": { "anyOf": ["pages", "feature", "shared"] } } }, "dependency": { "source": "@/**" } }
              },
              {
                "from": { "element": { "type": "pages" } },
                "allow": { "to": { "element": { "types": { "anyOf": ["feature", "shared"] } } }, "dependency": { "source": "@/**" } }
              },
              {
                "from": { "element": { "type": "feature" } },
                "allow": { "to": { "element": { "type": "shared" } }, "dependency": { "source": "@/**" } }
              },
              {
                "from": { "element": { "types": { "anyOf": ["app", "pages", "feature", "shared"] } } },
                "allow": { "to": { "element": { "type": "package" } }, "dependency": { "source": "@mx/*" } }
              },
              { "disallow": { "to": { "module": { "source": "mapbox-gl" } } } }
            ]
          }
        ]
      }
    }
  ]
}
