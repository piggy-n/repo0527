{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "vue", "promise", "vitest"],
  "jsPlugins": ["eslint-plugin-boundaries"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "settings": {
    "import/resolver": {
      "typescript": {
        "project": ["apps/web/tsconfig.app.json", "packages/*/tsconfig.lib.json"],
        "noWarnOnMultipleProjects": true
      }
    },
    "boundaries/elements": [
      { "type": "app", "pattern": "apps/web/src/app" },
      { "type": "pages", "pattern": "apps/web/src/pages" },
      { "type": "feature", "pattern": "apps/web/src/features/*", "capture": ["name"] },
      { "type": "shared", "pattern": "apps/web/src/shared" },
      { "type": "lib", "pattern": "apps/web/src/libs/*", "capture": ["name"] },
      { "type": "package", "pattern": "packages/*", "capture": ["name"] }
    ]
  },
  "rules": {
    "typescript/no-unsafe-type-assertion": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss"] }],

    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "lodash-es", "importNames": ["default"], "message": "lodash-es 按需具名导入" }
        ],
        "patterns": [
          { "regex": "^lodash(/|$)", "message": "使用 lodash-es 并按需具名导入" }
        ]
      }
    ],

    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-deprecated": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{js,mjs,cjs}"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["scripts/**", "apps/web/tools/**", "packages/*/tools/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/*/src/**", "packages/*/tools/**"],
      "rules": {
        "boundaries/dependencies": [
          "error",
          {
            "default": "disallow",
            "checkAllOrigins": true,
            "checkInternals": true,
            "policies": [
              { "allow": { "to": { "module": { "origin": "external" } } } },
              { "allow": { "to": { "module": { "origin": "core" } } } },
              { "allow": { "dependency": { "relationship": { "to": "internal" }, "source": "@(./|+(../))**" } } }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "boundaries/dependencies": [
          "error",
          {
            "default": "disallow",
            "checkAllOrigins": true,
            "checkInternals": true,
            "policies": [
              { "allow": { "to": { "module": { "origin": "external" } } } },
              { "allow": { "dependency": { "relationship": { "to": "internal" }, "source": "@(./|+(../))**" } } },
              {
                "from": { "element": { "type": "app" } },
                "allow": { "to": { "element": { "types": { "anyOf": ["pages", "feature", "shared"] } } }, "dependency": { "source": "@/**" } }
              },
              {
                "from": { "element": { "type": "pages" } },
                "allow": { "to": { "element": { "types": { "anyOf": ["feature", "shared"] } } }, "dependency": { "source": "@/**" } }
              },
              {
                "from": { "element": { "type": "feature" } },
                "allow": { "to": { "element": { "type": "shared" } }, "dependency": { "source": "@/**" } }
              },
              {
                "from": { "element": { "types": { "anyOf": ["app", "pages", "feature", "shared"] } } },
                "allow": { "to": { "element": { "type": "lib" } }, "dependency": { "source": "@yzt/*" } }
              },
              {
                "from": { "element": { "types": { "anyOf": ["app", "pages", "feature", "shared"] } } },
                "allow": { "to": { "element": { "type": "package" } }, "dependency": { "source": "@yzt/*" } }
              },
              {
                "from": { "element": { "type": "lib", "captured": { "name": "{ui,map-core,map-cesium,map-vue}" } } },
                "allow": {
                  "to": { "element": { "type": "lib", "captured": { "name": "utils" } } },
                  "dependency": { "source": "@yzt/*" }
                }
              },
              {
                "from": { "element": { "type": "lib", "captured": { "name": "{map-cesium,map-vue}" } } },
                "allow": {
                  "to": { "element": { "type": "lib", "captured": { "name": "map-core" } } },
                  "dependency": { "source": "@yzt/*" }
                }
              },
              {
                "from": { "element": { "type": "lib", "captured": { "name": "map-vue" } } },
                "allow": {
                  "to": { "element": { "type": "lib", "captured": { "name": "map-cesium" } } },
                  "dependency": { "source": "@yzt/*", "nodeKind": "dynamic-import" }
                }
              },
              {
                "from": { "element": { "type": "lib", "captured": { "name": "{utils,map-core,map-cesium}" } } },
                "disallow": {
                  "to": {
                    "module": {
                      "source": ["vue", "vue-router", "pinia", "element-plus", "@vue/**", "@element-plus/**"]
                    }
                  }
                }
              },
              { "disallow": { "to": { "module": { "source": "mapbox-gl" } } } }
            ]
          }
        ]
      }
    }
  ]
}
