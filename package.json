{
  "name": "repo0527",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm -r test",
    "deps:check": "pnpm outdated -r --include-github-actions",
    "deps:update:within-range": "pnpm -r update --include-github-actions",
    "deps:update:allow-major": "pnpm update -r -i --latest --include-github-actions",
    "pnpm:update:project:latest": "pnpm self-update && pnpm install --lockfile-only && node scripts/pnpm-major.mjs && pnpm install --lockfile-only"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
