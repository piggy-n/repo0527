root = true

[*]
charset = utf-8

# 保留已有文件换行，不在此强制 end_of_line
[*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 120
ij_continuation_indent_size = 2
ij_formatter_tags_enabled = true

# 短列表单行，长列表整体换行，每项一行
# 保留手动整理的逐项换行，避免重排 JSX 条件表达式
ij_any_keep_line_breaks = true
ij_any_keep_simple_blocks_in_one_line = false
ij_any_keep_simple_methods_in_one_line = false
ij_any_if_brace_force = always
ij_any_method_parameters_wrap = on_every_item
ij_any_method_parameters_new_line_after_left_paren = true
ij_any_method_parameters_right_paren_on_new_line = true
ij_any_call_parameters_wrap = on_every_item
ij_any_call_parameters_new_line_after_left_paren = true
ij_any_call_parameters_right_paren_on_new_line = true
ij_any_parentheses_expression_new_line_after_left_paren = true
ij_any_parentheses_expression_right_paren_on_new_line = true
ij_any_array_initializer_wrap = on_every_item
ij_any_array_initializer_new_line_after_left_brace = true
ij_any_array_initializer_right_brace_on_new_line = true
ij_any_align_multiline_parameters = false
ij_any_align_multiline_parameters_in_calls = false
ij_any_align_multiline_array_initializer_expression = false
ij_any_space_after_comma = true

# JavaScript 与 JSX
ij_javascript_use_semicolon_after_statement = true
ij_javascript_force_semicolon_style = true
ij_javascript_use_double_quotes = false
ij_javascript_force_quote_style = true
ij_javascript_enforce_trailing_comma = remove
ij_javascript_spaces_within_object_literal_braces = true
ij_javascript_spaces_within_object_type_braces = true
ij_javascript_spaces_within_imports = true
ij_javascript_space_within_array_initializer_brackets = false
ij_javascript_object_literal_wrap = on_every_item
ij_javascript_object_types_wrap = on_every_item
ij_javascript_imports_wrap = on_every_item
ij_javascript_align_imports = false
ij_javascript_align_object_properties = 0

# TypeScript 与 TSX，保持与 JavaScript 相同的规则
ij_typescript_use_semicolon_after_statement = true
ij_typescript_force_semicolon_style = true
ij_typescript_use_double_quotes = false
ij_typescript_force_quote_style = true
ij_typescript_enforce_trailing_comma = remove
ij_typescript_spaces_within_object_literal_braces = true
ij_typescript_spaces_within_object_type_braces = true
ij_typescript_spaces_within_imports = true
ij_typescript_space_within_array_initializer_brackets = false
ij_typescript_object_literal_wrap = on_every_item
ij_typescript_object_types_wrap = on_every_item
ij_typescript_imports_wrap = on_every_item
ij_typescript_align_imports = false
ij_typescript_align_object_properties = 0

# JSX / TSX 的标签排版使用 WebStorm 的 HTML 格式化规则
[*.{jsx,tsx}]
ij_html_attribute_wrap = on_every_item
ij_html_new_line_before_first_attribute = when_multiline
ij_html_new_line_after_last_attribute = when_multiline
ij_html_align_attributes = false
ij_html_keep_line_breaks = true
ij_html_keep_line_breaks_in_text = true
ij_html_space_inside_empty_tag = true
ij_html_space_around_equality_in_attribute = false
