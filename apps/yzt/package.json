{
  "name": "yzt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:intranet": "vite --mode intranet",
    "build": "vite build",
    "build:intranet": "vite build --mode intranet",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:changed": "vitest run --changed main --passWithNoTests",
    "test:browser:install": "playwright install --only-shell chromium",
    "test:smoke": "playwright test --config tools/smoke/playwright.config.ts",
    "test:watch": "vitest",
    "title:generate": "node tools/system-title/cli.ts",
    "boundaries:generate": "node tools/boundaries/cli.ts",
    "basemap:generate": "node tools/static-basemap/cli.ts",
    "measure:map-load": "vite build && node tools/measure-map-load/cli.ts",
    "measure:3d": "node tools/measure-3d/cli.ts",
    "lcc2:register": "node tools/lcc2-register/cli.ts",
    "probe:resource-classes": "node tools/probe-resource-classes/cli.ts",
    "scope-files:generate": "node tools/scope-test-files/cli.ts",
    "symbols:import": "node tools/symbol-defaults/cli.ts",
    "icons": "yzt-icons src/assets/icons src/shared/icons/icons.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "catalog:",
    "@maplibre/maplibre-gl-style-spec": "catalog:",
    "@tanstack/vue-query": "^5.104.1",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-clip": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "catalog:",
    "@turf/intersect": "^7.4.0",
    "@turf/simplify": "catalog:",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "catalog:",
    "@mx/icons": "workspace:*",
    "@mx/map-core": "workspace:*",
    "@mx/map-tools": "workspace:*",
    "@mx/map-vue": "workspace:*",
    "@mx/theme": "workspace:*",
    "@mx/ui": "workspace:*",
    "@mx/utils": "workspace:*",
    "axios": "^1.20.0",
    "core-js": "^3.50.0",
    "d3-force": "3.0.0",
    "d3-geo": "3.1.1",
    "d3-polygon": "3.0.1",
    "docx-preview": "0.4.1",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "element-plus": "catalog:",
    "fflate": "^0.8.3",
    "geographiclib-geodesic": "catalog:",
    "gsap": "3.13.0",
    "idb-keyval": "^6.3.0",
    "jwt-decode": "^4.0.0",
    "maplibre-gl": "catalog:",
    "marked": "^18.1.1",
    "nanoevents": "catalog:",
    "pinia": "^4.0.3",
    "shpjs": "^6.2.0",
    "sm-crypto-v2": "^1.15.1",
    "sortablejs": "^1.15.7",
    "three": "catalog:",
    "vue": "catalog:",
    "vue-router": "^5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mx/map-three": "workspace:*",
    "@types/d3-force": "3.0.10",
    "@types/d3-geo": "3.1.1",
    "@types/d3-polygon": "3.0.2",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "@types/sortablejs": "^1.15.9",
    "@types/three": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "msw": "^2.15.0",
    "opentype.js": "^2.0.0",
    "playwright": "catalog:",
    "proj4": "^2.22.0",
    "sass-embedded": "catalog:",
    "sirv": "^3.0.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "catalog:"
  }
}
