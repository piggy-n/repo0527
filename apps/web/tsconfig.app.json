{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["es2023", "esnext.disposable", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["vite/client", "geojson"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@yzt/map-core/worker": ["./src/libs/map-core/worker.ts"],
      "@yzt/*": ["./src/libs/*/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/libs/css-modules.d.ts", "src/**/*.worker.ts"]
}
