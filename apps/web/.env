# 变量说明见 docs/config/env.md；VITE_ 开头的变量会写进构建产物，不能放密钥

VITE_APP_TITLE=江苏省统一调查监测现状图

# 开发和生产都请求同源的 /backend，由 Vite 或 nginx 转发到后端并去掉前缀（ADR 0008）
VITE_API_BASE_URL=/backend

# 登录密码加密用的 SM2 公钥，由后端提供；公钥本身是公开的（ADR 0015）
VITE_LOGIN_PUBLIC_KEY=04d2bf639d9af435eda6d2d4645065bbae328f88eafb3e91dcb15c137fc5def8e2e3b8a03ef439ae40f85ce0233562ddbe650a6615fe5a3aebc17bd0d6c33cfa83

# 天地图开关：不能访问公网的内网部署设为 false，地图不再向天地图发任何请求（ADR 0031）
VITE_TIANDITU_ENABLED=true

# 天地图的浏览器端 key，开启时必填；它本来就写在每个瓦片地址里，防盗用靠天地图控制台的白名单和配额（ADR 0031）
VITE_TIANDITU_KEY=13745b0fcfbe2e1b5c92b77d173e8974

# 开发服务器和 vite preview 的代理目标，只在 vite.config.ts 中读取；个人临时覆盖写在 .env.local
PROXY_TARGET=http://192.168.153.194:18010

# 离开页面后是否重置：false 时现状底图、指标 AI 计算切走再回来保留上次的状态（页面缓存，ADR 0063）；
# true 时每次进入都是初始状态（二维、没有打开的面板，ADR 0114）；只管页面缓存，偏好是否恢复看下面的开关（ADR 0140）
VITE_PAGE_STATE_RESET=true

# 偏好（IndexedDB）的总开关：false 时下面五项都不读不写，存下的数据保留，重新打开后还能恢复（ADR 0140）
VITE_PREFERENCES_ENABLED=true
# 底图和透明度：false 时每次进入都是默认底图
VITE_PREFERENCE_BASEMAP=false
# 行政区边界的级别和透明度
VITE_PREFERENCE_BOUNDARIES=true
# 资源图层的勾选、透明度、顺序和年份
VITE_PREFERENCE_RESOURCE_LAYERS=true
# 资源图层的符号样式
VITE_PREFERENCE_RESOURCE_SYMBOLS=true
# 资源图层面板的收起和高度比例
VITE_PREFERENCE_RESOURCE_PANEL=true

# 资源的最小显示级别：true 时按发布目录的 resource-min-zooms.json 限制（ADR 0137），没到层级不请求瓦片、提示放大到几级；
# false 时不限制，各级都请求瓦片，低级别的瓦片可能有十几 MB，只用于排查和应急（ADR 0132）
VITE_RESOURCE_MIN_ZOOM_ENABLED=false

# AI 对话的后端是另一个服务，同样请求同源的 /ai-backend，由 Vite 或 nginx 转发并去掉前缀（docs/modules/ai-chat.md）
VITE_AI_API_BASE_URL=/ai-backend

# AI 后端的代理目标，只在 vite.config.ts 中读取；沿用旧项目的本机开发地址，尚未联调
AI_PROXY_TARGET=http://localhost:8090
