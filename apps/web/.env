# 变量说明见 docs/config/env.md；VITE_ 开头的变量会写进构建产物，不能放密钥

VITE_APP_TITLE=江苏省统一调查监测现状图

# 开发和生产都请求同源的 /backend，由 Vite 或 nginx 转发到后端并去掉前缀（ADR 0008）
VITE_API_BASE_URL=/backend

# 登录密码加密用的 SM2 公钥，由后端提供；公钥本身是公开的（ADR 0015）
VITE_LOGIN_PUBLIC_KEY=04d2bf639d9af435eda6d2d4645065bbae328f88eafb3e91dcb15c137fc5def8e2e3b8a03ef439ae40f85ce0233562ddbe650a6615fe5a3aebc17bd0d6c33cfa83

# 开发服务器和 vite preview 的代理目标，只在 vite.config.ts 中读取；个人临时覆盖写在 .env.local
PROXY_TARGET=http://192.168.1.180:18010
