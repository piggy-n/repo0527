{
  "name": "@yzt/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:intranet": "vite --mode intranet",
    "build": "vite build",
    "build:intranet": "vite build --mode intranet",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:install": "playwright install --only-shell chromium",
    "test:smoke": "playwright test --config tools/smoke/playwright.config.ts",
    "test:watch": "vitest",
    "title:generate": "node tools/system-title/cli.ts",
    "boundaries:generate": "node tools/boundaries/cli.ts",
    "measure:map-load": "vite build && node tools/measure-map-load/cli.ts",
    "icons": "yzt-icons src/assets/icons src/shared/icons/icons.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@tanstack/vue-query": "^5.104.1",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-clip": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "@yzt/icons": "workspace:*",
    "axios": "^1.20.0",
    "cesium": "1.146.0",
    "core-js": "^3.50.0",
    "d3-force": "3.0.0",
    "d3-geo": "3.1.1",
    "d3-polygon": "3.0.1",
    "docx-preview": "0.4.1",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.6",
    "geographiclib-geodesic": "^2.2.0",
    "gsap": "3.13.0",
    "idb-keyval": "^6.3.0",
    "jwt-decode": "^4.0.0",
    "maplibre-gl": "^6.12.0",
    "marked": "^18.1.1",
    "nanoevents": "^10.0.0",
    "pinia": "^4.0.3",
    "sm-crypto-v2": "^1.15.1",
    "sortablejs": "^1.15.7",
    "three": "0.183.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/d3-geo": "3.1.1",
    "@types/d3-polygon": "3.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/sortablejs": "^1.15.9",
    "@types/three": "0.183.1",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.64.0",
    "sass-embedded": "^1.105.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  }
}
